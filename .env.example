# websocket server endpoint (defaults to official pokemon showdown server)
# PS_SERVER_URL=wss://sim3.psim.us/showdown/websocket

# side server connection parameters (optional)
# PS_SERVER_ID=showdown
# PS_SERVER_HOST=sim3.psim.us
# PS_SERVER_PORT=443
# PS_SERVER_SSL=true
# PS_DISCOVER_SERVER=false

# login server and endpoint (optional)
# PS_LOGIN_SERVER=play.pokemonshowdown.com
# PS_LOGIN_URL=https://play.pokemonshowdown.com/api/login

# bot credentials
PS_USERNAME=YourBotName
PS_PASSWORD=YourBotPassword

# rooms to auto-join
PS_ROOMS=botdevelopment

# avatar id (optional)
# PS_AVATAR=169

# reconnect delay in milliseconds
# PS_RECONNECT_DELAY_MS=10000

# command prefix character
# PS_COMMAND_CHAR=.

# auto-accept battle challenges
# PS_AUTO_BATTLE=true

# allowed battle formats (comma-separated, defaults to gen9randombattle)
# PS_BATTLE_FORMATS=gen9randombattle

# packed team string for constructed formats (optional)
# PS_BATTLE_TEAM=
