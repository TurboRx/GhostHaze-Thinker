# websocket server endpoint
# PS_SERVER_URL=wss://sim3.psim.us/showdown/websocket

# login api endpoint
# PS_LOGIN_URL=https://play.pokemonshowdown.com/api/login

# bot credentials
PS_USERNAME=BotName
PS_PASSWORD=BotPassword

# rooms to auto-join
PS_ROOMS=botdevelopment

# avatar id (optional)
# PS_AVATAR=169

# reconnect delay in milliseconds
# PS_RECONNECT_DELAY_MS=10000

# command prefix character
# PS_COMMAND_CHAR=.
